# ─────────────────────────────────────────────────────────────────────────────
# STAGING — copie pra `.env.staging` e preencha. NUNCA use credenciais de produção
# aqui. O boot da API RECUSA subir (APP_ENV=staging) se SUPABASE_URL for o de prod
# ou se WHATSAPP_MODE não for "simulator". Ver docs/STAGING.md.
# ─────────────────────────────────────────────────────────────────────────────

# Marca este ambiente como staging (liga a trava de segurança no boot).
APP_ENV=staging

# NUNCA envia WhatsApp de verdade — as mensagens ficam só no simulador do dashboard.
WHATSAPP_MODE=simulator

# ── Banco ISOLADO (NÃO é o de produção) ──────────────────────────────────────
# Opção A (recomendada, grátis): Supabase LOCAL — rode `pnpm staging:db` e copie
#   os valores que o `supabase start` imprime (API URL + service_role + anon).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<cole o service_role key do `supabase start`>
SUPABASE_ANON_KEY=<cole o anon key do `supabase start`>
# Opção B: um 2º projeto Supabase (free) só pra staging — cole a URL/keys dele.

# ── Redis isolado ────────────────────────────────────────────────────────────
# Local (docker/homebrew) ou um Redis separado. NÃO reuse o Redis de produção.
REDIS_URL=redis://localhost:6379

# ── LLM (pode reusar a mesma key do OpenRouter — é leitura, sem risco a prod) ──
OPENROUTER_API_KEY=<sua key openrouter>
OPENROUTER_MODEL=z-ai/glm-5.2

# ── Opcionais (deixe em branco em staging) ───────────────────────────────────
# Sem tokens de zpro/uazapi: em simulator nada é enviado mesmo.
NODE_ENV=development
LOG_LEVEL=debug
