# Supabase
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# OpenRouter (LLM principal — configurável em runtime via apps/api/data/prompts.json)
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Gemini (fallback / OCR de receitas)
GOOGLE_GENAI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL_VISION=gemini-2.5-pro-preview-03-25

# Google Maps/Places (Legacy Nearby Search + Geocoding fallback)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# ── WhatsApp: seletor de provedor por instância ──────────────────────────────
# sara (Xarlote, usuário) usa a API OFICIAL via zpro/WABA; agent (farmácias) segue uazapi.
# Valores: zpro | uazapi. Se vazio, auto-detecta (zpro quando configurado e sem token uazapi).
WHATSAPP_PROVIDER_SARA=zpro
WHATSAPP_PROVIDER_AGENT=uazapi

# zpro (API Externa oficial / WhatsApp Business API) — leg da sara
# A URL externa que o painel fornece é {ZPRO_BASE_URL}/v2/api/external/{ZPRO_SARA_API_ID}
ZPRO_BASE_URL=https://backhub.criate.online
ZPRO_SARA_API_ID=
ZPRO_SARA_TOKEN=
# Segredo do webhook de entrada — vai na URL (?key=...) configurada no painel do zpro.
ZPRO_WEBHOOK_SECRET=change-me-32-chars-random-string
# Token de acesso do WhatsApp Business (Meta) — necessário SÓ pra baixar mídia recebida
# (áudio/imagem), pois o zpro entrega URLs do Meta (lookaside.fbsbx.com) que são
# protegidas. Pegue no painel do zpro (config da conexão WABA) ou no Meta Business
# Manager → WhatsApp → API Setup (ideal: token permanente de System User).
ZPRO_SARA_META_TOKEN=

# uazapi (não-oficial) — leg das farmácias (agent) e fallback de dev
UAZAPI_SERVER_URL=
UAZAPI_SARA_INSTANCE=sara
UAZAPI_SARA_TOKEN=
UAZAPI_AGENT_INSTANCE=agent
UAZAPI_AGENT_TOKEN=
UAZAPI_WEBHOOK_SECRET=change-me-32-chars-random-string

# Redis (BullMQ — apenas para deploy com workers; não necessário no modo simulator)
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
PORT=3001
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info

# Segurança da API (F0)
# ADMIN_API_TOKEN: token forte exigido por /admin e /api/simulate. GERE um random
#   (ex: `openssl rand -hex 32`) e configure no servidor (Railway) E no dashboard
#   (NEXT_PUBLIC_ADMIN_API_TOKEN em apps/web/.env.local) com o MESMO valor.
#   Em produção, se não setado, /admin retorna 503 (fail-closed).
ADMIN_API_TOKEN=
# CORS_ORIGINS: origens de browser permitidas (lista separada por vírgula).
#   Vazio em dev = qualquer localhost; vazio em prod = nega cross-origin.
CORS_ORIGINS=

# Rate-limit do envio WhatsApp (fila outbound — evita ban). Por número.
WA_RATE_MAX=1
WA_RATE_DURATION_MS=1200

# LGPD
PRIVACY_POLICY_URL=https://iadasaude.com/privacidade
PRIVACY_POLICY_VERSION=1.0
DPO_EMAIL=dpo@iadasaude.com
