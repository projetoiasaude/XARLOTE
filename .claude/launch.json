{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xarlote-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3005", "-d", "site", "--bind", "127.0.0.1"],
      "port": 3005
    },
    {
      "name": "xarlote-web",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_API_URL=http://localhost:3001", "pnpm", "--filter", "web", "dev"],
      "port": 3002
    },
    {
      "name": "xarlote-api",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ROLE=all", "WHATSAPP_MODE=simulator", "pnpm", "--filter", "@iasaude/api", "dev"],
      "port": 3001
    }
  ]
}
