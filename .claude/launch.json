{
  "version": "0.0.1",
  "configurations": [
    {
      "// mobile-preview": "Serve o export WEB do app nativo (apps/mobile) só pra CONFERIR layout sem simulador. Gere antes com: pnpm --filter @iasaude/mobile exec expo export --platform web --output-dir dist-web",
      "name": "xarlote-mobile-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3006", "-d", "apps/mobile/dist-web", "--bind", "127.0.0.1"],
      "port": 3006
    },
    {
      "name": "xarlote-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3005", "-d", "site", "--bind", "127.0.0.1"],
      "port": 3005
    },
    {
      "name": "xarlote-web",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_API_URL=http://localhost:3001", "pnpm", "--filter", "web", "dev"],
      "port": 3002
    },
    {
      "name": "xarlote-api",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ROLE=all", "WHATSAPP_MODE=simulator", "pnpm", "--filter", "@iasaude/api", "dev"],
      "port": 3001
    }
  ]
}
