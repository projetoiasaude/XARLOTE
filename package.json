{
  "name": "ia-da-saude",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @iasaude/api dev",
    "dev:worker": "pnpm --filter @iasaude/worker dev",
    "dev:web": "pnpm --filter @iasaude/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "start:prod": "concurrently --kill-others-on-fail --names api,worker --prefix-colors blue,green \"pnpm --filter @iasaude/api start\" \"pnpm --filter @iasaude/worker start\""
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
