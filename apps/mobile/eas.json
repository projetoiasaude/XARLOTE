{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "//pnpm": "TEM que casar com o packageManager da raiz do monorepo. Sem esta linha o build do EAS morre em 'Failed to install pnpm' — ele não adivinha a versão, e o lockfile v9 não é aceito por outra major.",
      "pnpm": "9.15.9",
      "env": {
        "NODE_ENV": "production"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ia-da-saude-api-production.up.railway.app"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ia-da-saude-api-production.up.railway.app"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ia-da-saude-api-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
